{
  "name": "@diister/mongodbee-studio",
  "version": "0.23.0-beta.41",
  "description": "A local database explorer for MongoDBee projects, opened with `mongodbee studio`",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "keywords": [
    "mongodb",
    "mongodbee",
    "studio",
    "database",
    "explorer"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/diister-dev/mongodbee.git",
    "directory": "studio"
  },
  "homepage": "https://github.com/diister-dev/mongodbee/blob/main/doc/STUDIO.md",
  "bugs": "https://github.com/diister-dev/mongodbee/issues",
  "engines": {
    "node": ">=22.18"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/mod.d.ts",
      "default": "./dist/mod.js"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@diister/mongodbee": "0.23.0-beta.41",
    "mongodb": "7.7.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@types/bun": "1.4.2",
    "@types/node": "22.20.4",
    "bun-plugin-svelte": "0.0.6",
    "lucide": "1.47.0",
    "svelte": "5.57.1",
    "typescript": "6.0.3"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && bun run build:ui",
    "build:ui": "bun run scripts/build-ui.ts",
    "check": "tsc -p tsconfig.json --noEmit",
    "lint": "biome lint .",
    "fmt": "biome format --write .",
    "fmt:check": "biome format .",
    "test": "bun test --parallel"
  }
}
