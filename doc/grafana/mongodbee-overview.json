      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "editorMode": "code",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(traces_span_metrics_duration_seconds_bucket{db_system_name=\"mongodb\",service_name=~\"$service\",db_namespace=~\"$namespace\",db_collection_name=~\"$collection\",span_name!=\"mongodb.transaction\"}[$__rate_interval])))",
          "legendFormat": "p50",
          "range": true,
          "refId": "A"
